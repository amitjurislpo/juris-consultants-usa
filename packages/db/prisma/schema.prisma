generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  STAFF
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum EntityType {
  LLC
  CCORP
}

enum StateCode {
  TEXAS
  CALIFORNIA
  WYOMING
  DELAWARE
  FLORIDA
  NEW_YORK
  NEVADA
  NEW_MEXICO
  WASHINGTON
}

enum LeadFlow {
  START
  MANAGE
  EXPERT
  GLOBAL
}

enum OrderKind {
  FORMATION
  SERVICES
  CONSULTATION
  GLOBAL
}

enum OrderStatus {
  DRAFT
  PAID
  DETAILS_PENDING
  READY_FOR_REVIEW
  FILING_SUBMITTED
  APPROVED_BY_STATE
  EIN_RECEIVED
  COMPLETED
  BOOKED
}

enum CatalogItemType {
  PLAN
  ADDON
  SERVICE
  FEE
}

enum BillingCycle {
  ONE_TIME
  MONTHLY
  YEARLY
}

enum PaymentProviderName {
  MOCK
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum KycAppliesTo {
  OWNER
  ORDER
  SERVICE
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConsultationStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum IntakeInputType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  DATE
  TEXTAREA
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  emailVerified DateTime?
  name        String?
  image       String?
  phone       String?
  country     String?
  role        UserRole    @default(CUSTOMER)
  passwordHash String?
  /// IANA time zone the admin chose as default (e.g. "Asia/Kolkata"). Null = IST.
  timezone    String?
  status      UserStatus  @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  accounts     Account[]
  sessions     Session[]
  companies    Company[]
  orders       Order[]
  leads        Lead[]
  reviewedKyc  KycDocument[] @relation("KycReviewer")
  deliverables Deliverable[]
  notes        Note[]          @relation("NoteAuthor")
  customerNotes Note[]         @relation("NoteCustomer")
  assignedOrders Order[]       @relation("OrderAssignee")
  statusChanges OrderStatusChange[]
  auditLogs    AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}

model Lead {
  id          String   @id @default(cuid())
  userId      String?
  contactInfo Json
  flow        LeadFlow
  stepReached Int
  source      String?
  createdAt   DateTime @default(now())

  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  notes Note[]

  @@index([flow, createdAt])
  @@index([userId])
}

model Company {
  id         String     @id @default(cuid())
  userId     String
  name       String
  state      StateCode
  entityType EntityType
  isExisting Boolean    @default(false)
  ein        String?
  address    Json
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  members Member[]
  orders  Order[]

  @@index([userId])
  @@index([state])
}

model Member {
  id        String  @id @default(cuid())
  companyId String
  name      String
  role      String
  ownership Decimal @db.Decimal(5, 2)
  country   String

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kycDocuments KycDocument[]

  @@index([companyId])
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  companyId String?
  kind      OrderKind
  status    OrderStatus @default(DRAFT)
  tags      String[]    @default([])
  totalUsd  Decimal     @db.Decimal(12, 2)
  currency  String      @default("USD")
  createdAt DateTime    @default(now())
  paidAt    DateTime?
  updatedAt DateTime    @updatedAt
  /// Staff member looking after this order (admin "Assigned").
  assignedToId String?
  /// Set when the customer has saved the company details (replaces guessing from members).
  detailsSubmittedAt DateTime?

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTo    User?            @relation("OrderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  company       Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]
  kycDocuments  KycDocument[]
  deliverables  Deliverable[]
  intakeAnswers IntakeAnswer[]
  consultations Consultation[]
  notes         Note[]
  emailLogs     EmailLog[]
  statusChanges OrderStatusChange[]

  @@index([userId, createdAt])
  @@index([assignedToId])
  @@index([companyId])
  @@index([status])
}

model OrderItem {
  id               String       @id @default(cuid())
  orderId          String
  catalogItemId    String
  nameSnapshot     String
  priceUsdSnapshot Decimal      @db.Decimal(12, 2)
  billing          BillingCycle
  qty              Int          @default(1)

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([catalogItemId])
}

model Payment {
  id          String              @id @default(cuid())
  orderId     String
  provider    PaymentProviderName
  providerRef String?
  amount      Decimal             @db.Decimal(12, 2)
  status      PaymentStatus       @default(PENDING)
  rawEvent    Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRef])
  @@index([orderId])
}

model CatalogItem {
  id          String           @id @default(cuid())
  type        CatalogItemType
  slug        String           @unique
  name        String
  description String?
  priceUsd    Decimal          @db.Decimal(12, 2)
  billing     BillingCycle     @default(ONE_TIME)
  mandatory   Boolean          @default(false)
  active      Boolean          @default(true)
  sort        Int              @default(0)
  warnings    Json             @default("[]")

  orderItems OrderItem[]

  @@index([type, active, sort])
}

model StateFee {
  id               String    @id @default(cuid())
  state            StateCode @unique
  feeUsd           Decimal   @db.Decimal(12, 2)
  active           Boolean   @default(true)
  premiumAvailable Boolean   @default(false)
  notes            String?

  @@index([active])
}

model BusinessType {
  id     String  @id @default(cuid())
  label  String  @unique
  active Boolean @default(true)
  sort   Int     @default(0)

  @@index([active, sort])
}

model KycRequirement {
  id        String        @id @default(cuid())
  appliesTo KycAppliesTo
  docType   String
  label     String
  active    Boolean       @default(true)

  @@unique([appliesTo, docType])
  @@index([active])
}

model KycDocument {
  id           String    @id @default(cuid())
  orderId      String
  memberId     String?
  docType      String
  fileKey      String
  status       KycStatus @default(PENDING)
  rejectReason String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  member     Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  reviewedBy User?   @relation("KycReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([orderId, status])
  @@index([memberId])
}

model Deliverable {
  id           String   @id @default(cuid())
  orderId      String
  type         String
  fileKey      String
  uploadedById String
  createdAt    DateTime @default(now())

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model IntakeQuestion {
  id        String          @id @default(cuid())
  group     String
  label     String
  inputType IntakeInputType
  options   Json            @default("[]")
  active    Boolean         @default(true)
  sort      Int             @default(0)

  answers IntakeAnswer[]

  @@unique([group, label])
  @@index([active, sort])
}

model IntakeAnswer {
  id         String @id @default(cuid())
  orderId    String
  questionId String
  value      Json

  order    Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  question IntakeQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([orderId, questionId])
  @@index([questionId])
}

model Consultation {
  id               String             @id @default(cuid())
  orderId          String             @unique
  calendlyEventUri String?
  startsAt         DateTime?
  status           ConsultationStatus @default(SCHEDULED)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/// A staff note. It belongs to an order, a customer (userId) or a lead (leadId).
model Note {
  id        String   @id @default(cuid())
  orderId   String?
  userId    String?
  leadId    String?
  authorId  String
  body      String
  createdAt DateTime @default(now())

  order    Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer User?  @relation("NoteCustomer", fields: [userId], references: [id], onDelete: Cascade)
  lead     Lead?  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author   User   @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([userId, createdAt])
  @@index([leadId, createdAt])
}

/// One row per order status change, with the date and the reason (for example why details were sent back).
model OrderStatusChange {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  reason     String?
  actorId    String?
  at         DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, at])
  @@index([toStatus, at])
}

model AuditLog {
  id       String   @id @default(cuid())
  actorId  String?
  action   String
  entity   String
  entityId String
  before   Json?
  after    Json?
  ip       String?
  at       DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId, at])
  @@index([actorId, at])
}

model EmailLog {
  id       String      @id @default(cuid())
  to       String
  template String
  orderId  String?
  status   EmailStatus @default(QUEUED)
  at       DateTime    @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId, at])
  @@index([status, at])
  @@index([to, at])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
}

/// Failed admin sign-in counter. Escalating blocks: 3 fails = 15 min, 4th = 1 hour, 5th+ = 1 day.
/// A successful sign-in (or a super admin's "Unlock") resets it. Only real admin accounts get a row.
model AdminLoginLock {
  email        String    @id
  failures     Int       @default(0)
  lockedUntil  DateTime?
  lastFailedAt DateTime?
  updatedAt    DateTime  @updatedAt
}

enum EnquiryStatus {
  NEW
  HANDLED
}

/// A message sent from the public "Send us a message" contact form.
model Enquiry {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String?
  message     String
  status      EnquiryStatus @default(NEW)
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
}
