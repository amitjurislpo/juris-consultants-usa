{
  "name": "@juris/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:validate": "prisma validate",
    "db:seed": "prisma db seed",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "db:seed-sample": "tsx scripts/seed-sample.ts",
    "db:seed-sample-admin": "tsx scripts/seed-sample-admin.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
