# Copy to .env.local and replace placeholders. Never commit .env.local.
# Use the PostgreSQL URL provided by Neon or another PostgreSQL provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate a distinct 32+ character random secret for each Vercel app.
AUTH_SECRET=

# Email OTP delivery (local development logs the code if no provider is configured).
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# First super admin. These values are required when running the seed.
SEED_SUPER_ADMIN_EMAIL=
# At least 12 characters.
SEED_SUPER_ADMIN_PASSWORD=
# Base32 secret configured in the super admin's authenticator app.
SEED_SUPER_ADMIN_TOTP_SECRET=

# Required only when enabling Vercel Blob storage.
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
